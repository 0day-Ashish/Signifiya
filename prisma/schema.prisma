generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  emailVerified    Boolean
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  collegeName      String?
  gender           String?
  mobileNo         String?
  role             String?
  bookingId        String?   @unique
  accounts         Account[]
  registeredEvents Event[]
  generatedPasses  Pass[]
  sessions         Session[]

  @@map("user")
}

model Event {
  id               String                 @id @default(uuid())
  name             String
  description      String?
  date             DateTime
  location         String?
  userId           String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  price            Int                    @default(0)
  type             String?
  user             User?                  @relation(fields: [userId], references: [id])
  participantTeams ParticipantTeamEvent[]

  @@map("event")
}

model Pass {
  id                    String               @id @default(uuid())
  type                  String
  qrCode                String?
  validUntil            DateTime
  userId                String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  visitorRegistrationId String?              @unique
  bookingId             String?              @unique
  userBookingId         String?
  verifiedAt            DateTime?
  verifiedBy            String?
  verifiedDay1At        DateTime?
  verifiedDay1By        String?
  verifiedDay2At        DateTime?
  verifiedDay2By        String?
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitorRegistration   VisitorRegistration? @relation(fields: [visitorRegistrationId], references: [id])

  @@map("pass")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Issue {
  id        String   @id @default(uuid())
  text      String
  email     String?
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolved  Boolean  @default(false)

  @@map("issue")
}


model VisitorRegistration {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String
  college         String
  passType        String
  amount          Int
  status          String   @default("pending")
  paymentProofUrl String?
  userId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bookingId       String?  @unique
  userBookingId   String?
  pass            Pass?

  @@map("visitor_registration")
}

model ParticipantTeam {
  id               String                  @id @default(uuid())
  teamName         String
  leaderName       String
  leaderEmail      String
  leaderPhone      String
  college          String
  totalAmount      Int
  status           String                  @default("pending")
  paymentProofUrl  String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  eventTime        String?
  leaderBookingId  String?
  qrCode           String?
  leaderAttendedAt DateTime?
  leaderAttendedBy String?
  events           ParticipantTeamEvent[]
  members          ParticipantTeamMember[]

  @@map("participant_team")
}

model ParticipantTeamMember {
  id         String          @id @default(uuid())
  name       String
  teamId     String
  createdAt  DateTime        @default(now())
  college    String?
  email      String?
  phone      String?
  gameId     String?         // Riot ID (Valorant), Free Fire ID, UUID (BGMI), eFootball ID
  attendedAt DateTime?
  attendedBy String?
  team       ParticipantTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("participant_team_member")
}

model ParticipantTeamEvent {
  teamId    String
  eventId   String
  createdAt DateTime        @default(now())
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team      ParticipantTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, eventId])
  @@map("participant_team_event")
}

model OrganizingMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  category  String
  image     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizing_member")
}

model CountdownDate {
  id         String   @id @default(uuid())
  targetDate DateTime
  label      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("countdown_date")
}

model MerchOrder {
  id                String   @id @default(uuid())
  orderNumber       String   @unique
  userId            String?
  userBookingId     String?
  name              String
  email             String
  phone             String
  college           String?
  merchItemId       Int
  merchItemName     String
  size              String?
  color             String?
  customText        String?
  quantity          Int      @default(1)
  unitPrice         Int
  totalAmount       Int
  paymentMethod     String   @default("utr")
  utrId             String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            String   @default("pending")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  discountAmount    Int      @default(0)
  discountApplied   Boolean  @default(false)
  referralBookingId String?

  @@map("merch_order")
}
